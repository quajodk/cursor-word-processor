node_modules/
dist/
.DS_Store
*.tsbuildinfo
corpus/files/
bench/out/
.scriv-cache/
.env
.env.local

# Corpus: real-world documents collected from the wild. Large and re-fetchable,
# so contents stay out of git while provenance manifests stay tracked.
corpus/docx/*
!corpus/docx/MANIFEST.json
corpus/md/*
!corpus/md/MANIFEST.json
corpus/text/*
!corpus/text/MANIFEST.json

# Written by every `bun run perf`. A benchmark result is an observation of one machine
# at one moment, not a fact about the repository; tracking it made every perf run dirty the
# tree and turned a real regression into a merge conflict.
packages/perf/bench/out/perf.json
